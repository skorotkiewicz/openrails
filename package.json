{
  "name": "openrails",
  "private": true,
  "type": "module",
  "workspaces": ["openrails-sdk"],
  "dependencies": {"@openrails/sdk": "workspace:*"},
  "scripts": {
    "build:sdk": "bun run --cwd openrails-sdk build",
    "test:sdk": "bun run --cwd openrails-sdk test",
    "test": "bun run test:sdk && cargo test --locked && cargo build --locked && node tests/sdk.mjs"
  }
}
