{
  "name": "@openrails/sdk",
  "version": "0.1.0",
  "description": "Typed server-side client for the self-hosted OpenRails backend",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck && node --test tests/*.mjs",
    "prepack": "npm run build"
  },
  "engines": {"node": ">=20"},
  "devDependencies": {"typescript": "^5.7.0"}
}
