{
  "name": "@railcode/sdk",
  "version": "0.4.0",
  "description": "Railcode backend SDK \u2014 the typed client for apps-v2 workers (db, files, sql, queries, llm, email, agents, secrets, ctx, service connectors).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
