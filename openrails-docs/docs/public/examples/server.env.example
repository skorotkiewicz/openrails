# Public template, not usable credentials. Replace every REPLACE_WITH value.
# Single-project mode:
export OPENRAILS_TOKEN='REPLACE_WITH_EXISTING_SINGLE_PROJECT_KEY'
export OPENRAILS_BIND='127.0.0.1:8787'
export OPENRAILS_PUBLIC_URL='http://127.0.0.1:8787'
export OPENRAILS_DB_PATH='.openrails/backend.sqlite3'
export OPENRAILS_FILES_DIR='.openrails/files'
export OPENRAILS_CONFIG='config.json'

# Multi-project mode: use projects.json as config.json and supply distinct keys.
# OPENRAILS_TOKEN grants no master access; OPENRAILS_FILES_DIR is single-project only.
export OPENRAILS_PROJECTS_DIR='.openrails/projects'
export APP_API_KEY='REPLACE_WITH_EXISTING_APP_PROJECT_KEY'
export CRM_API_KEY='REPLACE_WITH_EXISTING_CRM_PROJECT_KEY'

# Optional integration credentials, referenced by the JSON examples:
export LLM_API_KEY='REPLACE_WITH_PROVIDER_SECRET'
export RESEND_API_KEY='REPLACE_WITH_EMAIL_PROVIDER_SECRET'
export MODEL_SERVICE_TOKEN='REPLACE_WITH_HTTP_SERVICE_SECRET'
