{
  "projects": {
    "demo": {
      "api_key_env": "DEMO_API_KEY",
      "config": {
        "users": [
          { "uuid": "owner", "name": "Demo Owner", "email": "owner@example.com", "is_admin": true }
        ],
        "llm": {
          "base_url": "http://192.168.0.124:8888/v1",
          "model": "/models/gemma4/E2B/gemma-4-E2B-it-Q4_K_M.gguf",
          "provider": "local"
        },
        "queries": {
          "demo_task": {
            "description": "Read a record from the demo collection",
            "sql": "SELECT key, json_extract(value, '$.title') AS title FROM kv WHERE scope = '' AND collection = 'demo_tasks' AND key = $1",
            "params": [{ "name": "key", "type": "string" }]
          }
        },
        "service_connectors": {
          "models": {
            "base_url": "http://192.168.0.124:8888",
            "description": "Local llama.cpp model discovery",
            "allowed_methods": ["GET"],
            "usage_instructions": "GET /v1/models to inspect available local models."
          }
        }
      }
    },
    "crm": {
      "api_key_env": "CRM_API_KEY",
      "config": {
        "users": [
          { "uuid": "owner", "name": "CRM Owner", "email": "crm@example.com", "is_admin": true }
        ]
      }
    }
  }
}
