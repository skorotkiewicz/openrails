{
  "projects": {
    "shop": {
      "api_key_env": "SHOP_API_KEY",
      "config": {
        "users": [
          { "uuid": "owner", "name": "Shop Owner", "email": "shop@example.com", "is_admin": true }
        ],
        "queries": {
          "task_by_key": {
            "description": "Read a task stored in the shop project",
            "sql": "SELECT key, json_extract(value, '$.title') AS title FROM kv WHERE scope = '' AND collection = 'tasks' AND key = $1",
            "params": [{ "name": "key", "type": "string" }]
          }
        }
      }
    },
    "crm": {
      "api_key_env": "CRM_API_KEY",
      "config": {
        "users": [
          { "uuid": "owner", "name": "CRM Owner", "email": "crm@example.com", "is_admin": true }
        ]
      }
    }
  }
}
